        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum(rate(portal_runs_submitted_total{instance=~\"$instance\"}[$__rate_interval])) * 60", "legendFormat": "submitted", "range": true, "refId": "D"}
