        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_milliseconds_bucket{instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p95", "range": true, "refId": "B"}
