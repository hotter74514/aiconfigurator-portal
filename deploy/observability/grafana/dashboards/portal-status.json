        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum(rate(http_server_duration_milliseconds_count{instance=~\"$instance\",http_status_code=~\"5..\"}[$__rate_interval]))", "legendFormat": "5xx", "range": true, "refId": "B"}
