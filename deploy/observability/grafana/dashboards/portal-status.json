      "pluginVersion": "12.3.1",
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum(portal_runs_queued{instance=~\"$instance\"})", "instant": true, "legendFormat": "queued", "range": false, "refId": "A"}],
